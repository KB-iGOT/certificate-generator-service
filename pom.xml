<project
        xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.sunbird</groupId>
    <artifactId>certificate-generator-service</artifactId>
    <version>1.2.0</version>
    <packaging>pom</packaging>
    <name>certificate-generator-service</name>
    <properties>
        <project.version>1.2.0</project.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <jackson.version>2.15.2</jackson.version>
        <akka.x.version>2.6.21</akka.x.version>
        <junit.version>4.12</junit.version>

        <version.compiler.plugin>3.10.1</version.compiler.plugin>
        <scoverage.plugin.version>1.4.1</scoverage.plugin.version>
        <slf4j.version>2.0.9</slf4j.version>
        <logback.version>1.4.14</logback.version>

        <play2.version>2.8.22</play2.version>
        <scala.major.version>2.13</scala.major.version>
        <scala.version>2.13.12</scala.version>
        <jacoco.version>0.8.8</jacoco.version>
        <httpClient.version>4.5.14</httpClient.version>
        <jacoco.maven.plugin.version>0.8.10</jacoco.maven.plugin.version>
        <sonar.java.binaries>${project.basedir}/target/scala-2.13/classes</sonar.java.binaries>
        <sonar.scala.coverage.reportPath>${project.basedir}/target/scoverage.xml</sonar.scala.coverage.reportPath>
    </properties>

    <modules>
        <module>sb-utils</module>
        <module>cassandra-utils</module>
        <module>certificate-processor</module>
        <module>all-actors</module>
        <module>cache-utils</module>
        <module>service</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>4.0.0.4121</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
