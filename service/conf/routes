# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

#Health check
GET  /health                                  @controllers.health.HealthController.getHealth(request: play.mvc.Http.Request)
GET  /:service/health                      @controllers.health.HealthController.getServiceHealth(service:String, request: play.mvc.Http.Request)
GET  /liveness                                  @controllers.health.HealthController.getLiveness(request: play.mvc.Http.Request)

# Certificate APIs
POST /v1/certs/generate                    @controllers.certs.CertsGenerationController.generateCertificate(request: play.mvc.Http.Request)
GET /v1/certs/legacy/generate/:uid                    @controllers.certs.CertsGenerationController.generateCertificatesLegacyApp(uid: String, request: play.mvc.Http.Request)
POST /v1/admin/certs/generate                    @controllers.certs.CertsGenerationController.generateCertificatesByAdmin(request: play.mvc.Http.Request)

# Milestone Achievement API
POST /v1/milestone/achievements/generate                    @controllers.milestoneAchievements.MilestoneAchievementsGenerationController.generateMilestoneAchievement(request: play.mvc.Http.Request)